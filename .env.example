# Sikkim Darshan — environment
#
# Every value here is OPTIONAL. The app builds, renders and deploys with this
# file empty: the archive ships as typed data in src/data, so there is no
# hard dependency on any external service.

# --- Public origin (set this before any real deploy) -----------------------
# Absolute URLs in metadata — Open Graph images, canonicals, sitemap entries —
# have to name a host. Unset, SITE_URL falls back to http://localhost:3000, so
# every shared link and every social preview points at a machine that is not
# the internet. This is the one value here that is optional for `npm run dev`
# and effectively required for production.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (optional live overlay) -------------------------------------
# Without these, getSupabase() returns null and every page falls back to the
# local data layer. To go live: create a free Supabase project, run
# supabase/schema.sql then supabase/seed.sql in the SQL editor, and paste the
# project URL and PUBLISHABLE key below.
#
# Only the publishable (or legacy anon) key belongs here. NEXT_PUBLIC_* values
# are shipped to the browser — the service-role key must never appear.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Anthropic (optional, research engine only) ----------------------------
# Powers the TerraStory research engine's claim extraction and narrative
# composition (scripts/research/). Unset, the engine reports the provider as
# UNAVAILABLE and falls back to a deterministic rule-based extractor -- it
# never guesses, and the site builds and renders exactly the same without it.
#
# Never referenced by the application at request time: research and narrative
# generation are offline jobs, so opening a page cannot create a paid call.
#
#   export ANTHROPIC_API_KEY=...
#   npm run research:evaluate -- --live
ANTHROPIC_API_KEY=

# --- Google Maps Platform (optional, agents only) --------------------------
# Used by `npm run agent:360` to query the Street View Static metadata
# endpoint, the only sanctioned way to check panorama availability. Unset, the
# agent records an explicit "not checked" result instead of guessing.
# Never referenced by the app itself.
GOOGLE_MAPS_API_KEY=

# --- Agent reproducibility (optional) --------------------------------------
# Pins the "retrieved at" date stamped onto records by `npm run agent:discover`
# so a re-run reproduces an earlier output. Defaults to today.
RETRIEVED_AT=


# --- Postgres (optional, the Darshan /d/ surface only) ---------------------
# The v2 destination and site pages under /d/ are read from Postgres via
# Drizzle. Unset, src/db reports that no database is configured, those routes
# build zero pages, and every other page renders exactly as before — the
# fifteen-destination site needs none of this. Set it and the /d/ pages
# appear on the next build.
#
# Supabase: Project Settings → Database → Connection string (URI, pooled).
# Server only. Never prefixed NEXT_PUBLIC_, never read in a client component.
DATABASE_URL=
# Direct (non-pooled) connection, used by drizzle-kit for migrations only.
DIRECT_URL=
# Service-role key: read only inside src/db and src/lib/payments (CLAUDE.md §8).
SUPABASE_SERVICE_ROLE_KEY=

# --- Partner programme ------------------------------------------------------
# Reviewers who may open /admin/partners, as a comma-separated allowlist of
# e-mail addresses. Sign-in is by e-mail one-time code (Supabase Auth); an
# address not on this list is a partner or a traveller, never a reviewer.
ADMIN_EMAILS=

# --- TerraStory Guide (the AI tourism assistant) -----------------------------
# Every one of these is optional. With none set, the Guide still answers every
# question it can from TerraStory's own records — places, straight-line
# distances, permits, audio guides, advisories — and says plainly what it
# cannot do. See docs/guide-assistant.md.
#
# Groq: words answers from retrieved records, translates them, screens for
# prompt injection, and transcribes voice questions (Whisper). Server only.
GROQ_API_KEY=
# Optional model overrides. Defaults: openai/gpt-oss-120b, then
# openai/gpt-oss-20b when the first is rate-limited.
ASSISTANT_MODEL=
ASSISTANT_FALLBACK_MODEL=
# OSRM base URL for road distance, drive time and the route line. The public
# demo server (https://router.project-osrm.org) is for development only under
# its fair-use policy; production needs a self-hosted OSRM or a licensed
# provider. Unset, the Guide gives straight-line distances, labelled as such.
ROUTING_OSRM_URL=
# "open-meteo" enables current weather and today's forecast. Open-Meteo's
# free tier is non-commercial; a commercial deployment needs its paid plan.
WEATHER_PROVIDER=
# Server-generated speech, cached in the private "assistant-audio" bucket.
# Off unless both are set. Groq Orpheus requires accepting the model's terms
# in the Groq console first. Unset, answers are read by the device's own voice.
ASSISTANT_TTS_PROVIDER=
ASSISTANT_TTS_VOICE=
